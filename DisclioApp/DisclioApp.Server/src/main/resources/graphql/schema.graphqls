input SongInput {
    title: String!
    duration: String
    trackNumber: Int
}

type CD {
    id: Int
    title: String
    artist: String
    category: String
    manufacturer: String
    year: Int
    condition: String
    rating: Int
    description: String
    songs: [Song]
    photos: [String]
}

type Song {
    id: Int!
    cdId: Int!
    title: String!
    duration: String
    trackNumber: Int
}

type Query {
    cds: [CD]
    cd(id: Int!): CD
    pagedCds(page: Int!, size: Int!): [CD]
    totalCount: Int
    ratingStats: [RatingStat]
    songFrequencyStats: [SongFrequencyStat]
    songsByCd(cdId: Int!): [Song]
}

type Mutation {
    addCD(
        title: String!,
        artist: String!,
        category: String,
        manufacturer: String,
        year: Int,
        condition: String,
        rating: Int,
        description: String,
        songs: [SongInput],
        photos: [String]
    ): String

    updateCD(
        id: Int!,
        title: String!,
        artist: String!,
        category: String,
        manufacturer: String,
        year: Int,
        condition: String,
        rating: Int,
        description: String,
        songs: [SongInput],
        photos: [String]
    ): CD
    deleteCD(id: Int!): String

    addSong(
        id: Int,
        cdId: Int!,
        title: String!,
        duration: String,
        trackNumber: Int
    ): Song
    deleteSong(id: Int!): Boolean
    startGenerator: String
    stopGenerator: String
}

type RatingStat { rating: Int, count: Int }
type SongFrequencyStat { songCount: Int, numberOfCds: Int }

extend type Query {
    me: User
    userExists(username: String!): Boolean
    getChatHistory(user1: String!, user2: String!): [ChatMessage]
}

extend type Mutation {
    login(username: String!, password: String!): User
    requestPasswordReset(identifier: String!): PasswordResetResponse
    resetPassword(token: String!, newPassword: String!): Boolean
    signup(
        username: String!,
        password: String!,
        firstName: String,
        lastName: String,
        email: String
    ): User
    logout: Boolean
}

type Role {
    id: Int
    name: String
}

type User {
    id: Int
    username: String
    firstName: String
    lastName: String
    email: String
    role: Role
}

type ChatMessage {
    sender: String
    content: String
    recipient: String
    timestamp: String
}

type Log {
    id: Int
    userId:Int
    groupRole: String
    actionInformation: String
    timestamp: String
}

extend type Query {
    getSystemLogs: [Log]
    pagedSystemLogs(page: Int!, size: Int!): [Log]
    totalLogCount: Int
}

type PasswordResetResponse {
    message: String
    resetToken: String
}

extend type Mutation {
    createManualLog(userId: Int!, role: String!, action: String!): String
}

type SuspiciousUser {
    id: Int
    userId: Int
    username: String
    reason: String
    detectedAt: String
}

extend type Query {
    getObservationList: [SuspiciousUser]
}
